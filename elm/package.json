{
  "name": "hn-epistemic-observatory-elm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Elm front-end for the HN Epistemic Observatory display layer",
  "scripts": {
    "predev": "npm run fixtures",
    "dev": "concurrently -n elm,srv -c green,blue \"elm-watch hot\" \"npx serve static -l 3000\"",
    "dev:elm": "elm-watch hot",
    "dev:serve": "npx serve static -l 3000",
    "fixtures": "node scripts/seed-fixtures.js",
    "diff": "node scripts/diff-parity.js",
    "build": "npm run build:elm && npm run build:bundle",
    "build:elm": "elm make src/Main.elm --optimize --output=dist/elm.js",
    "build:bundle": "node scripts/bundle.js",
    "build:debug": "elm make src/Main.elm --debug --output=dist/elm.js",
    "minify": "terser dist/elm.js --compress 'pure_funcs=[F2,F3,F4,F5,F6,F7,F8,F9,A2,A3,A4,A5,A6,A7,A8,A9],pure_getters,passes=2' --mangle --output dist/elm.min.js",
    "test": "elm-test",
    "test:watch": "elm-test --watch",
    "review": "elm-review",
    "review:fix": "elm-review --fix",
    "clean": "rm -rf dist elm-stuff",
    "format": "elm-format src/ tests/ --yes",
    "validate": "elm make src/Main.elm --output=/dev/null && npm test && npm run review",
    "postbuild": "npm run minify"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "elm": "latest-0.19.3",
    "elm-format": "^0.8.8",
    "elm-review": "^2.13.5",
    "elm-test": "0.19.3-0",
    "elm-watch": "^1.2.9",
    "serve": "^14.2.0",
    "terser": "^5.37.0"
  }
}
